# Everything below is yours to fill in: Vitrina ships no shared keys or accounts.

# Postgres (docker compose default)
DATABASE_URL=postgres://vitrina:vitrina@localhost:5432/vitrina

# AI provider: anthropic | openai | llama. If empty, the first key that is set wins (in that order).
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# OPENAI_BASE_URL=   # optional, for an OpenAI-compatible proxy
LLAMA_API_KEY=
LLAMA_BASE_URL=https://api.llama.com/compat/v1/
LLAMA_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8

# PayPal sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_WEBHOOK_ID=

APP_URL=http://localhost:3000
FX_RATES_JSON={"ARS":0.00085}

# Smoke test: your sandbox Business account email, so test orders can be paid
SMOKE_PAYEE_EMAIL=
